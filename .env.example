# ============================================================
# 100K Launch Bot - Environment Variables Template
# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit your actual ".env" file to git.
#
#   cp .env.example .env
#
# ============================================================

# Telegram Bot Token
# Get this from @BotFather on Telegram:
#   1. Open Telegram, search for "BotFather"
#   2. Send /newbot and follow the prompts
#   3. Copy the token BotFather gives you (looks like 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID (optional, restricts bot to only respond to you)
# Get your numeric ID from @userinfobot on Telegram
# Leave blank to allow anyone who finds the bot to use it
TELEGRAM_ALLOWED_USER_ID=

# Google Gemini API Key (free tier)
# Get this from https://aistudio.google.com/apikey
#   1. Sign in with a Google account
#   2. Click "Create API key" (no credit card required for the free tier)
#   3. Copy the key it gives you
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for content generation
# Defaults to gemini-2.0-flash if left blank. Check
# https://ai.google.dev/gemini-api/docs/models for current free-tier model
# names if this one is ever retired.
GEMINI_MODEL=gemini-2.0-flash

# Path to the JSON data file used for persistent storage
# Defaults to "data.json" in the project root if left blank.
DATA_FILE=data.json

# Launch start date in YYYY-MM-DD format.
# Defaults to the date the bot is first run if left blank.
LAUNCH_START_DATE=

# Keep-alive web server (for free-tier hosts like Replit that spin the
# project down without HTTP traffic). Set to "true" on Replit and point an
# uptime pinger (UptimeRobot, cron-job.org) at the Repl's URL every 5
# minutes. Leave unset/false for local runs or "Always On" hosting.
ENABLE_KEEP_ALIVE=false

# Port the keep-alive server listens on. Replit sets $PORT automatically;
# only override this for local testing of the keep-alive server itself.
PORT=8080

# Scheduled auto-generation: periodically generates content and sends it to
# whichever chat last ran /start, without you having to type /generate.
# Set to "true" to enable.
AUTO_GENERATE_ENABLED=false

# How often to auto-generate, in hours. Defaults to 24 (once a day).
AUTO_GENERATE_INTERVAL_HOURS=24

# Comma-separated content types to rotate through, one per run, in order.
# Valid types: youtube, blog, email, reddit, twitter, product
AUTO_GENERATE_TYPES=youtube,blog,reddit,twitter
